# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string
DB_URI=

# Stripe
# Publishable key -- safe to expose in the browser, must be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_API_KEY=
# Secret keys -- server-only, never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (password reset emails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# NextAuth (used to build absolute callback URLs in production)
NEXTAUTH_URL=
